+++ b/src/dxvk/dxvk_bc_format.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include "dxvk_include.h"
+
+namespace dxvk::bc {
+
+  /**
+   * \brief Uncompressed format used to emulate a BC format
+   *
+   * Some GPUs (all Mali drivers) do not expose textureCompressionBC. For those
+   * the DXGI format table maps BC1-BC5 to an uncompressed format and the BC
+   * data is decoded on the CPU when it is uploaded, see dxvk_bc_decode.cpp.
+   * BC6H and BC7 are not emulated.
+   *
+   * \param [in] format BC Vulkan format
+   * \returns Replacement format, or VK_FORMAT_UNDEFINED if not emulated
+   */
+  inline VkFormat emulatedFormat(VkFormat format) {
+    switch (format) {
+      case VK_FORMAT_BC1_RGBA_UNORM_BLOCK:
+      case VK_FORMAT_BC2_UNORM_BLOCK:
+      case VK_FORMAT_BC3_UNORM_BLOCK:
+        return VK_FORMAT_R8G8B8A8_UNORM;
+
+      case VK_FORMAT_BC1_RGBA_SRGB_BLOCK:
+      case VK_FORMAT_BC2_SRGB_BLOCK:
+      case VK_FORMAT_BC3_SRGB_BLOCK:
+        return VK_FORMAT_R8G8B8A8_SRGB;
+
+      case VK_FORMAT_BC4_UNORM_BLOCK: return VK_FORMAT_R8_UNORM;
+      case VK_FORMAT_BC4_SNORM_BLOCK: return VK_FORMAT_R8_SNORM;
+      case VK_FORMAT_BC5_UNORM_BLOCK: return VK_FORMAT_R8G8_UNORM;
+      case VK_FORMAT_BC5_SNORM_BLOCK: return VK_FORMAT_R8G8_SNORM;
+
+      default:
+        return VK_FORMAT_UNDEFINED;
+    }
+  }
+
+
+  /**
+   * \brief Decodes BC1-BC5 data into the emulation format
+   *
+   * Source data is laid out in 4x4 blocks with the given pitches, in bytes.
+   * Output is tightly packed. Partial blocks at the right and bottom edges
+   * are cropped to the requested size.
+   *
+   * \param [in] format BC Vulkan format, see \ref emulatedFormat
+   * \param [in] src Compressed data
+   * \param [in] srcRowPitch Bytes between rows of blocks
+   * \param [in] srcDepthPitch Bytes between depth slices
+   * \param [out] dst Decoded texels
+   * \param [in] width Width in texels
+   * \param [in] height Height in texels
+   * \param [in] depth Depth in texels
+   */
+  void decode(
+          VkFormat      format,
+    const void*         src,
+          VkDeviceSize  srcRowPitch,
+          VkDeviceSize  srcDepthPitch,
+          void*         dst,
+          uint32_t      width,
+          uint32_t      height,
+          uint32_t      depth);
+
+}

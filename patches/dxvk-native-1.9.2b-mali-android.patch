+    const VkDeviceSize decodedSize = image->formatInfo()->elementSize
+      * util::flattenImageExtent(imageExtent);
+
+    for (uint32_t i = 0; i < imageSubresource.layerCount; i++) {
+      auto stagingSlice  = m_staging.alloc(CACHE_LINE_SIZE, decodedSize);
+      auto stagingHandle = stagingSlice.getSliceHandle();
+
+      bc::decode(bcFormat, srcData + i * layerPitch, rowPitch, slicePitch, stagingHandle.mapPtr,
+        imageExtent.width, imageExtent.height, imageExtent.depth);
+
+      auto subresource = imageSubresource;
+      subresource.baseArrayLayer += i;
+      subresource.layerCount = 1;
+
+      this->copyImageBufferData<true>(cmd,
+        image, subresource, imageOffset, imageExtent,
+        imageLayout, stagingHandle, 0, 0);
+
+      m_cmd->trackResource<DxvkAccess::Read>(stagingSlice.buffer());
+    }
+  }

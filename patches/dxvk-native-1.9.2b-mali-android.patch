+
+  void DxvkContext::copyBcBufferData(
+          DxvkCmdBuffer         cmd,
+    const Rc<DxvkImage>&        image,
+    const VkImageSubresourceLayers& imageSubresource,
+          VkOffset3D            imageOffset,
+          VkExtent3D            imageExtent,
+          VkImageLayout         imageLayout,
+    const Rc<DxvkBuffer>&       srcBuffer,
+          VkDeviceSize          srcOffset,
+          VkDeviceSize          rowAlignment,
+          VkDeviceSize          sliceAlignment) {
+    // Same as above, but the BC blocks are in a buffer that is laid out the way
+    // copyImageBufferData would read it. We need CPU access to decode them.
+    const VkFormat bcFormat = image->info().bcEmulation;
+    auto bcInfo = imageFormatInfo(bcFormat);
+
+    auto srcData = reinterpret_cast<const char*>(srcBuffer->mapPtr(srcOffset));
+
+    if (!srcData) {
+      Logger::err("DXVK: BC emulation: source buffer is not host visible, skipping copy");
+      return;
+    }
+
+    const VkDeviceSize elementSize = bcInfo->elementSize;
+    const VkExtent3D blockCount = util::computeBlockCount(imageExtent, bcInfo->blockSize);
+
+    VkDeviceSize rowPitch = blockCount.width * elementSize;
+
+    if (rowAlignment > elementSize)
+      rowPitch = rowAlignment >= rowPitch ? rowAlignment : align(rowPitch, rowAlignment);
+
+    VkDeviceSize slicePitch = blockCount.height * rowPitch;
+
+    if (image->info().type == VK_IMAGE_TYPE_3D && sliceAlignment > elementSize)

+  'sdl3/wsi_window_sdl3.cpp',
+]
+
 if dxvk_wsi == 'win32'
   wsi_src  = wsi_win32_src
   wsi_deps = []
 elif dxvk_wsi == 'sdl2'
   wsi_src  = wsi_sdl2_src
   wsi_deps = [ lib_sdl2 ]
+elif dxvk_wsi == 'sdl3'
+  wsi_src  = wsi_sdl3_src
+  wsi_deps = [ lib_sdl3 ]
 else
   error('Unknown wsi')
 endif
diff --git a/src/wsi/sdl3/wsi_helpers_sdl3.h b/src/wsi/sdl3/wsi_helpers_sdl3.h
new file mode 100644
index 0000000..33a4e37
--- /dev/null
+++ b/src/wsi/sdl3/wsi_helpers_sdl3.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_vulkan.h>
+
+#include "../wsi_monitor.h"
+
+namespace dxvk {
+
+  // SDL3 identifies displays by SDL_DisplayID rather than by index.
+  // The HMONITOR encoding used by DXVK stays index based, so translate here.
+  inline SDL_DisplayID getDisplayId(int32_t displayIndex) {
+    if (displayIndex < 0)
+      return 0;
+
+    int count = 0;
+    SDL_DisplayID* displays = SDL_GetDisplays(&count);
+
+    SDL_DisplayID id = 0;
+    if (displays != nullptr && displayIndex < count)
+      id = displays[displayIndex];
+
+    SDL_free(displays);
+    return id;
+  }
+
+  inline bool isDisplayValid(int32_t displayIndex) {
+    return getDisplayId(displayIndex) != 0;
+  }
+
+  inline int32_t getDisplayIndex(SDL_DisplayID displayId) {
+    int count = 0;
+    SDL_DisplayID* displays = SDL_GetDisplays(&count);
+
+    int32_t index = -1;
+    for (int i = 0; displays != nullptr && i < count; i++) {
+      if (displays[i] == displayId) {
+        index = i;
+        break;
+      }
+    }
+
+    SDL_free(displays);
+    return index;
+  }
+
+}
diff --git a/src/wsi/sdl3/wsi_mode_sdl3.cpp b/src/wsi/sdl3/wsi_mode_sdl3.cpp
new file mode 100644
index 0000000..9ae02a0
--- /dev/null
+++ b/src/wsi/sdl3/wsi_mode_sdl3.cpp
@@ -0,0 +1,99 @@
+#include "../wsi_mode.h"
+
+#include "wsi_helpers_sdl3.h"
+
+#include <wsi/native_wsi.h>
+
+#include "../../util/util_string.h"
+#include "../../util/log/log.h"
+
+namespace dxvk::wsi {
+
+  static inline uint32_t roundToNextPow2(uint32_t num) {
+    if (num-- == 0)
+      return 0;
+
+    num |= num >> 1; num |= num >> 2;
+    num |= num >> 4; num |= num >> 8;
+    num |= num >> 16;
+
+    return ++num;
+  }
+
+
+  static inline void convertMode(const SDL_DisplayMode& mode, WsiMode* pMode) {
+    const SDL_PixelFormatDetails* details = SDL_GetPixelFormatDetails(mode.format);
+
+    pMode->width          = uint32_t(mode.w);
+    pMode->height         = uint32_t(mode.h);
+    pMode->refreshRate    = WsiRational{ uint32_t(mode.refresh_rate * 1000.0f), 1000 };
+    // BPP should always be a power of two
+    // to match Windows behaviour of including padding.
+    pMode->bitsPerPixel   = roundToNextPow2(details ? details->bits_per_pixel : 32);
+    pMode->interlaced     = false;
+  }
+
+
+  bool getDisplayMode(
+          HMONITOR         hMonitor,
+          uint32_t         ModeNumber,
+          WsiMode*         pMode) {
+    const SDL_DisplayID displayId = getDisplayId(fromHmonitor(hMonitor));
+
+    if (displayId == 0)
+      return false;
+
+    int count = 0;
+    SDL_DisplayMode** modes = SDL_GetFullscreenDisplayModes(displayId, &count);
+
+    bool found = false;
+    if (modes != nullptr && ModeNumber < uint32_t(count)) {
+      convertMode(*modes[ModeNumber], pMode);
+      found = true;
+    }
+
+    SDL_free(modes);
+    return found;
+  }
+
+
+  bool getCurrentDisplayMode(
+          HMONITOR         hMonitor,
+          WsiMode*         pMode) {
+    const SDL_DisplayID displayId = getDisplayId(fromHmonitor(hMonitor));
+
+    if (displayId == 0)
+      return false;
+
+    const SDL_DisplayMode* mode = SDL_GetCurrentDisplayMode(displayId);
+    if (mode == nullptr) {
+      Logger::err(str::format("SDL_GetCurrentDisplayMode: ", SDL_GetError()));
+      return false;
+    }
+
+    convertMode(*mode, pMode);
+
+    return true;
+  }
+
+
+  bool getDesktopDisplayMode(
+          HMONITOR         hMonitor,
+          WsiMode*         pMode) {
+    const SDL_DisplayID displayId = getDisplayId(fromHmonitor(hMonitor));
+
+    if (displayId == 0)
+      return false;
+
+    const SDL_DisplayMode* mode = SDL_GetDesktopDisplayMode(displayId);
+    if (mode == nullptr) {
+      Logger::err(str::format("SDL_GetDesktopDisplayMode: ", SDL_GetError()));
+      return false;
+    }
+
+    convertMode(*mode, pMode);
+
+    return true;
+  }
+
+}
diff --git a/src/wsi/sdl3/wsi_monitor_sdl3.cpp b/src/wsi/sdl3/wsi_monitor_sdl3.cpp
new file mode 100644
index 0000000..8be0292
--- /dev/null
+++ b/src/wsi/sdl3/wsi_monitor_sdl3.cpp
@@ -0,0 +1,64 @@
+#include "../wsi_monitor.h"
+
+#include "wsi_helpers_sdl3.h"
+
+#include <windows.h>
+#include <wsi/native_wsi.h>
+
+#include <string>
+#include <sstream>
+
+namespace dxvk::wsi {
+
+  HMONITOR getDefaultMonitor() {
+    return enumMonitors(0);
+  }
+
+
+  HMONITOR enumMonitors(uint32_t index) {
+    return isDisplayValid(int32_t(index))
+      ? toHmonitor(index)
+      : nullptr;
+  }
+
+  bool getDisplayName(
+          HMONITOR         hMonitor,
+          WCHAR            (&Name)[32]) {
+    const int32_t displayIndex = fromHmonitor(hMonitor);
+
+    if (!isDisplayValid(displayIndex))
+      return false;
+
+    std::wstringstream nameStream;
+    nameStream << LR"(\\.\DISPLAY)" << (displayIndex + 1);
+
+    std::wstring name = nameStream.str();
+
+    std::memset(Name, 0, sizeof(Name));
+    name.copy(Name, name.length(), 0);
+
+    return true;
+  }
+
+
+  bool getDesktopCoordinates(
+          HMONITOR         hMonitor,
+          RECT*            pRect) {
+    const SDL_DisplayID displayId = getDisplayId(fromHmonitor(hMonitor));
+
+    if (displayId == 0)
+      return false;
+
+    SDL_Rect rect = { };
+    if (!SDL_GetDisplayBounds(displayId, &rect))
+      return false;
+
+    pRect->left   = rect.x;
+    pRect->top    = rect.y;
+    pRect->right  = rect.x + rect.w;
+    pRect->bottom = rect.y + rect.h;
+
+    return true;
+  }
+
+}
diff --git a/src/wsi/sdl3/wsi_presenter_sdl3.cpp b/src/wsi/sdl3/wsi_presenter_sdl3.cpp

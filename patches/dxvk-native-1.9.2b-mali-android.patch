+    return "SDL3 WSI";
+  }
+
+
+  DxvkNameSet DxvkPlatformExts::getInstanceExtensions() {
+    // SDL3 reports the required instance extensions from the active video
+    // driver, so no dummy window is needed. Video must already be initialized.
+    Uint32 extensionCount = 0;
+    const char* const* extensionNames = SDL_Vulkan_GetInstanceExtensions(&extensionCount);
+
+    if (extensionNames == nullptr)
+      throw DxvkError(str::format("SDL3 WSI: Failed to get instance extensions. ", SDL_GetError()));
+
+    DxvkNameSet names;
+    for (Uint32 i = 0; i < extensionCount; i++)
+      names.add(extensionNames[i]);
+
+    return names;
+  }
+
